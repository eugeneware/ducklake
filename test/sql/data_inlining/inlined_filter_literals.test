# name: test/sql/data_inlining/inlined_filter_literals.test
# description: Inlined filter constants are not metadata query placeholders
# group: [data_inlining]

require ducklake

require parquet

statement ok
ATTACH 'ducklake:{TEST_DIR}/inline_literals.db' AS lake (DATA_PATH '{TEST_DIR}/inline_literals', DATA_INLINING_ROW_LIMIT 100)

statement ok
CREATE TABLE lake.strings AS
SELECT v AS s, encode(v) AS b FROM unnest(['', 'first', 'second', '漢字']) t(v)

# Seed the physical values independently of the metadata writer's placeholder substitution.
statement ok
UPDATE __ducklake_metadata_lake.ducklake_inlined_data_1_1
SET s = '{SNAPSHOT_ID}', b = encode('{SNAPSHOT_ID}') WHERE s = 'first'

statement ok
UPDATE __ducklake_metadata_lake.ducklake_inlined_data_1_1
SET s = '{METADATA_CATALOG}', b = encode('{METADATA_CATALOG}') WHERE s = 'second'

foreach literal SNAPSHOT_ID METADATA_CATALOG

query I
SELECT count(*) FROM lake.strings WHERE s = '{' || '{literal}' || '}'
----
1

query I
SELECT count(*) FROM lake.strings WHERE b = encode('{' || '{literal}' || '}')
----
1

endloop
