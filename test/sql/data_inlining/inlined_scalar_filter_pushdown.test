# name: test/sql/data_inlining/inlined_scalar_filter_pushdown.test
# description: Scalar inline predicates reach the metadata query across physical encodings
# group: [data_inlining]

require ducklake

require parquet

require icu

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/inlined_scalar_filter_pushdown', DATA_INLINING_ROW_LIMIT 1000)

statement ok
CREATE TABLE lake.events AS
SELECT i AS id, i % 2 = 0 AS flag, (i + 0.25)::DECIMAL(18, 2) AS amount,
       (i + 0.25)::FLOAT AS single_value, (i + 0.25)::DOUBLE AS double_value,
       'key' || i AS label, encode('key' || i) AS bytes,
       DATE '2026-05-01' + i::INTEGER AS event_date,
       TIMESTAMP '2026-05-01' + i * INTERVAL 1 HOUR AS ts,
       TIMESTAMPTZ '2026-05-01 00:00:00+00' + i * INTERVAL 1 HOUR AS tz
FROM range(100) t(i)

query I
SELECT count(*) FROM ducklake_list_files('lake', 'events')
----
0

statement ok
CALL enable_logging('DuckLakeMetadata')

query I
SELECT count(*) FROM lake.events WHERE flag = true
----
50

query I
SELECT count(*) > 0 FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE query LIKE '%ducklake_inlined_data_%'
  AND regexp_matches(query, 'AND.*flag')
  AND CASE WHEN (SELECT catalog_type FROM lake.settings()) = 'postgres'
      THEN query LIKE '%postgres_query(%' ELSE true END
----
true

statement ok
CALL disable_logging()

statement ok
CALL enable_logging('DuckLakeMetadata')

query I
SELECT count(*) FROM lake.events WHERE amount = 73.25
----
1

query I
SELECT count(*) > 0 FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE query LIKE '%ducklake_inlined_data_%'
  AND regexp_matches(query, 'AND.*amount')
  AND CASE WHEN (SELECT catalog_type FROM lake.settings()) = 'postgres'
      THEN query LIKE '%postgres_query(%' ELSE true END
----
true

statement ok
CALL disable_logging()

statement ok
CALL enable_logging('DuckLakeMetadata')

