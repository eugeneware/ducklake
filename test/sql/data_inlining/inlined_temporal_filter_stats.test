# name: test/sql/data_inlining/inlined_temporal_filter_stats.test
# description: Inline temporal cast bounds belong to the scan snapshot and column type
# group: [data_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/inlined_temporal_filter_stats', METADATA_CATALOG 'inline_meta', DATA_INLINING_ROW_LIMIT 1000)

statement ok
CREATE TABLE lake.events (id INTEGER, ts TIMESTAMP)

statement ok
INSERT INTO lake.events VALUES (2, TIMESTAMP '2026-05-01'), (3, TIMESTAMP '2026-05-02')

statement ok
SET VARIABLE historical = (SELECT max(snapshot_id) FROM lake.snapshots())

statement ok
INSERT INTO lake.events VALUES (4, TIMESTAMP '2026-05-03')

# Seed an expired version of row 0 without changing the live rows or their bounds.
# Deleting an outlier through DuckLake can leave global bounds wide. This synthetic
# catalog keeps valid narrow current bounds alongside physical history they do not cover.
# The first three storage columns are row_id, begin_snapshot and end_snapshot in both versions.
statement ok
INSERT INTO inline_meta.ducklake_inlined_data_1_1
VALUES (0, getvariable('historical') - 1, getvariable('historical'), 99, CAST(TIMESTAMP '9999-01-01 (BC)' AS VARCHAR))

query I
SELECT count(*) = 1 FROM (
    SELECT id, ts, COLUMNS('.*begin_snapshot$') AS visible_from, COLUMNS('.*end_snapshot$') AS visible_until
    FROM inline_meta.ducklake_inlined_data_1_1
) expired
WHERE id = 99 AND year(ts::TIMESTAMP) < -4713
  AND visible_from < visible_until AND visible_until = getvariable('historical')
----
true

query I
SELECT min_value::TIMESTAMP = TIMESTAMP '2026-05-01' AND max_value::TIMESTAMP = TIMESTAMP '2026-05-03'
FROM inline_meta.ducklake_table_column_stats WHERE table_id = 1 AND column_id = 2
----
true

query IT
SELECT id, ts FROM lake.events ORDER BY id
----
2	2026-05-01 00:00:00
3	2026-05-02 00:00:00
4	2026-05-03 00:00:00

statement ok
CALL enable_logging('DuckLakeMetadata')

query I
SELECT id FROM lake.events WHERE ts > TIMESTAMP '2026-05-01' ORDER BY id
----
3
4

# Current bounds prove that PostgreSQL can cast every visible non-null value.
query I
SELECT count(*) = 0 FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE query LIKE '%ducklake_inlined_data_%' AND query LIKE '%CASE WHEN substring(ts%'
----
true

# Expired rows need not fit current bounds, even if the optimizer reorders predicates.
query I
SELECT CASE WHEN (SELECT catalog_type FROM lake.settings()) = 'postgres' THEN count(*) > 0 ELSE true END
FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE query LIKE '%ducklake_inlined_data_%'
  AND regexp_matches(query, 'CASE WHEN [0-9]+ >= .*begin_snapshot')
----
true

statement ok
CALL disable_logging()

statement ok
CALL enable_logging('DuckLakeMetadata')

# Even when current bounds fit, they do not describe an older snapshot.
query I
SELECT id FROM lake.events AT (VERSION => getvariable('historical')) WHERE ts > TIMESTAMP '2026-05-01'
----
3

query I
SELECT CASE WHEN (SELECT catalog_type FROM lake.settings()) = 'postgres' THEN count(*) > 0 ELSE true END
FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE query LIKE '%ducklake_inlined_data_%' AND query LIKE '%CASE WHEN substring(ts%'
----
true

statement ok
CALL disable_logging()

statement ok
BEGIN

statement ok
INSERT INTO lake.events VALUES (1, TIMESTAMP '9999-01-01 (BC)')

statement ok
CALL enable_logging('DuckLakeMetadata')

# Committed statistics cannot certify transaction-local changes.
query I
SELECT id FROM lake.events WHERE ts > TIMESTAMP '2026-05-01' ORDER BY id
----
3
4

query I
SELECT CASE WHEN (SELECT catalog_type FROM lake.settings()) = 'postgres' THEN count(*) > 0 ELSE true END
FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE query LIKE '%ducklake_inlined_data_%' AND query LIKE '%CASE WHEN substring(ts%'
----
true

statement ok
CALL disable_logging()

statement ok
COMMIT

# After commit, the wider bounds must retain the guard as well.
query I
SELECT id FROM lake.events WHERE ts > TIMESTAMP '2026-05-01' ORDER BY id
----
3
4

query I
SELECT count(*) FROM ducklake_list_files('lake', 'events')
----
0
