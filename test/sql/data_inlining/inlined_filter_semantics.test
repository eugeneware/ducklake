query I
WITH actual AS (SELECT * FROM lake.events WHERE double_value = 'NaN'::DOUBLE),
expected AS (SELECT * FROM reference WHERE double_value = 'NaN'::DOUBLE)
SELECT NOT EXISTS (
    (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected)
    UNION ALL
    (SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
)
----
true

