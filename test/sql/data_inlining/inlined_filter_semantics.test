WITH actual AS (SELECT * FROM lake.events WHERE amount = 73.25),
expected AS (SELECT * FROM reference WHERE amount = 73.25)
SELECT NOT EXISTS (
    (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected)
    UNION ALL
    (SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
)
