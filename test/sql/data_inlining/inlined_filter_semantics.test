true

# A selective FLOAT predicate
query I
WITH actual AS (SELECT * FROM lake.events WHERE single_value = 73.25::FLOAT),
expected AS (SELECT * FROM reference WHERE single_value = 73.25::FLOAT)
SELECT NOT EXISTS (
    (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected)
    UNION ALL
    (SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
)
----
true

# A short DOUBLE range
query I
WITH actual AS (SELECT * FROM lake.events WHERE double_value >= 73.25 AND double_value < 83.25),
expected AS (SELECT * FROM reference WHERE double_value >= 73.25 AND double_value < 83.25)
SELECT NOT EXISTS (
    (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected)
    UNION ALL
    (SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
)
----
true

# A selective VARCHAR predicate
query I
WITH actual AS (SELECT * FROM lake.events WHERE label = 'key73'),
expected AS (SELECT * FROM reference WHERE label = 'key73')
SELECT NOT EXISTS (
    (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected)
    UNION ALL
    (SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
)
----
true

# A selective BLOB predicate
query I
WITH actual AS (SELECT * FROM lake.events WHERE bytes = encode('key73')),
expected AS (SELECT * FROM reference WHERE bytes = encode('key73'))
SELECT NOT EXISTS (
    (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected)
    UNION ALL
    (SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
)
----
true

# A DATE predicate
query I
WITH actual AS (SELECT * FROM lake.events WHERE event_date = DATE '2026-05-05'),
expected AS (SELECT * FROM reference WHERE event_date = DATE '2026-05-05')
SELECT NOT EXISTS (
    (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected)
    UNION ALL
    (SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
)
----
true

# A TIMESTAMP range without an integer predicate
query I
WITH actual AS (SELECT * FROM lake.events WHERE ts >= TIMESTAMP '2026-05-01 00:20:00' AND ts < TIMESTAMP '2026-05-01 00:40:00'),
expected AS (SELECT * FROM reference WHERE ts >= TIMESTAMP '2026-05-01 00:20:00' AND ts < TIMESTAMP '2026-05-01 00:40:00')
SELECT NOT EXISTS (
    (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected)
    UNION ALL
    (SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
)
----
true

# A TIMESTAMPTZ range without an integer predicate
query I
WITH actual AS (SELECT * FROM lake.events WHERE tz >= TIMESTAMPTZ '2026-05-01 00:20:00+00' AND tz < TIMESTAMPTZ '2026-05-01 02:40:00+02'),
expected AS (SELECT * FROM reference WHERE tz >= TIMESTAMPTZ '2026-05-01 00:20:00+00' AND tz < TIMESTAMPTZ '2026-05-01 02:40:00+02')
SELECT NOT EXISTS (
    (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected)
    UNION ALL
    (SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
)
----
true

# The source ID and timestamp range from discussion 1134
query I
WITH actual AS (SELECT * FROM lake.events WHERE source_id = 23 AND tz >= TIMESTAMPTZ '2026-05-01 00:20:00+00' AND tz < TIMESTAMPTZ '2026-05-01 02:40:00+02'),
expected AS (SELECT * FROM reference WHERE source_id = 23 AND tz >= TIMESTAMPTZ '2026-05-01 00:20:00+00' AND tz < TIMESTAMPTZ '2026-05-01 02:40:00+02')
SELECT NOT EXISTS (
    (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected)
    UNION ALL
    (SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
)
----
true

# An integer range with a residual expression
query I
WITH actual AS (SELECT * FROM lake.events WHERE id >= 70 AND id < 90 AND id % 17 = 0),
expected AS (SELECT * FROM reference WHERE id >= 70 AND id < 90 AND id % 17 = 0)
SELECT NOT EXISTS (
    (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected)
    UNION ALL
    (SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
)
----
true

# A disjunction with an unsupported branch
query I
WITH actual AS (SELECT * FROM lake.events WHERE id = 73 OR id % 997 = 0),
expected AS (SELECT * FROM reference WHERE id = 73 OR id % 997 = 0)
SELECT NOT EXISTS (
    (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected)
    UNION ALL
    (SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
)
----
true

# A predicate on a nested value
query I
WITH actual AS (SELECT * FROM lake.events WHERE nested.value = 73),
expected AS (SELECT * FROM reference WHERE nested.value = 73)
SELECT NOT EXISTS (
    (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected)
    UNION ALL
    (SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
)
----
true

# An IN subquery that generates a runtime join filter
query I
WITH actual AS (SELECT * FROM lake.events WHERE id IN (SELECT range * 97 + 73 FROM range(200))),
expected AS (SELECT * FROM reference WHERE id IN (SELECT range * 97 + 73 FROM range(200)))
SELECT NOT EXISTS (
    (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected)
    UNION ALL
    (SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
)
----
true

