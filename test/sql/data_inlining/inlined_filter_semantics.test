# Large timestamp years
query I
WITH actual AS (SELECT * FROM lake.events WHERE ts >= TIMESTAMP '10000-01-01'),
expected AS (SELECT * FROM reference WHERE ts >= TIMESTAMP '10000-01-01')
SELECT NOT EXISTS (
    (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected)
    UNION ALL
    (SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
)
----
true

# Unicode text and NULLs
query I
WITH actual AS (SELECT * FROM lake.events WHERE label IN ('Å', 'key73', NULL)),
expected AS (SELECT * FROM reference WHERE label IN ('Å', 'key73', NULL))
SELECT NOT EXISTS (
    (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected)
    UNION ALL
    (SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
)
----
true

# Residual OR with NULLs
query I
WITH actual AS (SELECT * FROM lake.events WHERE id = 73 OR label IS NULL),
expected AS (SELECT * FROM reference WHERE id = 73 OR label IS NULL)
SELECT NOT EXISTS (
    (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected)
    UNION ALL
    (SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
)
----
true

# Residual AND with encoded values
query I
WITH actual AS (SELECT * FROM lake.events WHERE id < 0 AND bytes IS NOT NULL),
expected AS (SELECT * FROM reference WHERE id < 0 AND bytes IS NOT NULL)
SELECT NOT EXISTS (
    (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected)
    UNION ALL
    (SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
)
----
true
