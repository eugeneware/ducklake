# name: benchmark/micro/read/inlined_filters/integer_range.benchmark
# description: A short BIGINT range
# group: [read]

name Inlined Filter integer range
group micro
subgroup read

require ducklake

require parquet

include benchmark/micro/fixtures/inlined_filters.benchmark.in

run
SELECT id, payload FROM lake.events WHERE id >= 7000 AND id < 7100;

result_query I
WITH expected AS (SELECT id, payload FROM reference WHERE id >= 7000 AND id < 7100)
SELECT NOT EXISTS (
    (SELECT * FROM __answer EXCEPT ALL SELECT * FROM expected)
    UNION ALL
    (SELECT * FROM expected EXCEPT ALL SELECT * FROM __answer)
);
----
true
