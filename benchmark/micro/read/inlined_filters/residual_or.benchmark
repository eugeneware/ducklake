# name: benchmark/micro/read/inlined_filters/residual_or.benchmark
# description: A disjunction with an unsupported branch
# group: [read]

name Inlined Filter residual or
group micro
subgroup read

require ducklake

require parquet

include benchmark/micro/fixtures/inlined_filters.benchmark.in

run
SELECT id, payload FROM lake.events WHERE id = 73 OR id % 997 = 0;

result_query I
WITH expected AS (SELECT id, payload FROM reference WHERE id = 73 OR id % 997 = 0)
SELECT NOT EXISTS (
    (SELECT * FROM __answer EXCEPT ALL SELECT * FROM expected)
    UNION ALL
    (SELECT * FROM expected EXCEPT ALL SELECT * FROM __answer)
);
----
true
