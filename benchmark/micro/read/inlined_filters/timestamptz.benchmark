# name: benchmark/micro/read/inlined_filters/timestamptz.benchmark
# description: A TIMESTAMPTZ range without an integer predicate
# group: [read]

name Inlined Filter timestamptz
group micro
subgroup read

require ducklake

require parquet

include benchmark/micro/fixtures/inlined_filters.benchmark.in

run
SELECT id, payload FROM lake.events WHERE tz >= TIMESTAMPTZ '2026-05-05 00:00:00+00' AND tz < TIMESTAMPTZ '2026-05-06 12:00:00+02';

result_query I
WITH expected AS (SELECT id, payload FROM reference WHERE tz >= TIMESTAMPTZ '2026-05-05 00:00:00+00' AND tz < TIMESTAMPTZ '2026-05-06 12:00:00+02')
SELECT NOT EXISTS (
    (SELECT * FROM __answer EXCEPT ALL SELECT * FROM expected)
    UNION ALL
    (SELECT * FROM expected EXCEPT ALL SELECT * FROM __answer)
);
----
true
