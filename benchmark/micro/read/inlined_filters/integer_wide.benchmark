# name: benchmark/micro/read/inlined_filters/integer_wide.benchmark
# description: A selective BIGINT lookup projecting every data type
# group: [read]

name Inlined Filter integer wide
group micro
subgroup read

require ducklake

require parquet

include benchmark/micro/fixtures/inlined_filters.benchmark.in

run
SELECT * FROM lake.events WHERE id = 73;

result_query I
WITH expected AS (SELECT * FROM reference WHERE id = 73)
SELECT NOT EXISTS (
    (SELECT * FROM __answer EXCEPT ALL SELECT * FROM expected)
    UNION ALL
    (SELECT * FROM expected EXCEPT ALL SELECT * FROM __answer)
);
----
true
