# name: benchmark/micro/read/inlined_filters/nested.benchmark
# description: A predicate on a nested value
# group: [read]

name Inlined Filter nested
group micro
subgroup read

require ducklake

require parquet

include benchmark/micro/fixtures/inlined_filters.benchmark.in

run
SELECT id, payload FROM lake.events WHERE nested.value = 73;

result_query I
WITH expected AS (SELECT id, payload FROM reference WHERE nested.value = 73)
SELECT NOT EXISTS (
    (SELECT * FROM __answer EXCEPT ALL SELECT * FROM expected)
    UNION ALL
    (SELECT * FROM expected EXCEPT ALL SELECT * FROM __answer)
);
----
true
