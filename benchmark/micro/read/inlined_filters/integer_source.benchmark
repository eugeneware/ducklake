# name: benchmark/micro/read/inlined_filters/integer_source.benchmark
# description: A selective INTEGER source key
# group: [read]

name Inlined Filter integer source
group micro
subgroup read

require ducklake

require parquet

include benchmark/micro/fixtures/inlined_filters.benchmark.in

run
SELECT id, payload FROM lake.events WHERE source_id = 23;

result_query I
WITH expected AS (SELECT id, payload FROM reference WHERE source_id = 23)
SELECT NOT EXISTS (
    (SELECT * FROM __answer EXCEPT ALL SELECT * FROM expected)
    UNION ALL
    (SELECT * FROM expected EXCEPT ALL SELECT * FROM __answer)
);
----
true
