# name: benchmark/micro/read/inlined_filters/boolean.benchmark
# description: A selective BOOLEAN predicate
# group: [read]

name Inlined Filter boolean
group micro
subgroup read

require ducklake

require parquet

include benchmark/micro/fixtures/inlined_filters.benchmark.in

run
SELECT id, payload FROM lake.events WHERE flag = true;

result_query I
WITH expected AS (SELECT id, payload FROM reference WHERE flag = true)
SELECT NOT EXISTS (
    (SELECT * FROM __answer EXCEPT ALL SELECT * FROM expected)
    UNION ALL
    (SELECT * FROM expected EXCEPT ALL SELECT * FROM __answer)
);
----
true
