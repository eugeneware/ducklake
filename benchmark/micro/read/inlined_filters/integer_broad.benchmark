# name: benchmark/micro/read/inlined_filters/integer_broad.benchmark
# description: A BIGINT predicate matching ninety percent of the buffer
# group: [read]

name Inlined Filter integer broad
group micro
subgroup read

require ducklake

require parquet

include benchmark/micro/fixtures/inlined_filters.benchmark.in

run
SELECT id, payload FROM lake.events WHERE id < ${rows} * 9 // 10;

result_query I
WITH expected AS (SELECT id, payload FROM reference WHERE id < ${rows} * 9 // 10)
SELECT NOT EXISTS (
    (SELECT * FROM __answer EXCEPT ALL SELECT * FROM expected)
    UNION ALL
    (SELECT * FROM expected EXCEPT ALL SELECT * FROM __answer)
);
----
true
