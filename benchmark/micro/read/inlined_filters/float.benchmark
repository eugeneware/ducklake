# name: benchmark/micro/read/inlined_filters/float.benchmark
# description: A selective FLOAT predicate
# group: [read]

name Inlined Filter float
group micro
subgroup read

require ducklake

require parquet

include benchmark/micro/fixtures/inlined_filters.benchmark.in

run
SELECT id, payload FROM lake.events WHERE single_value = 73.25::FLOAT;

result_query I
WITH expected AS (SELECT id, payload FROM reference WHERE single_value = 73.25::FLOAT)
SELECT NOT EXISTS (
    (SELECT * FROM __answer EXCEPT ALL SELECT * FROM expected)
    UNION ALL
    (SELECT * FROM expected EXCEPT ALL SELECT * FROM __answer)
);
----
true
