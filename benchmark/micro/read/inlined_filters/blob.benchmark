# name: benchmark/micro/read/inlined_filters/blob.benchmark
# description: A selective BLOB predicate
# group: [read]

name Inlined Filter blob
group micro
subgroup read

require ducklake

require parquet

include benchmark/micro/fixtures/inlined_filters.benchmark.in

run
SELECT id, payload FROM lake.events WHERE bytes = encode('key73');

result_query I
WITH expected AS (SELECT id, payload FROM reference WHERE bytes = encode('key73'))
SELECT NOT EXISTS (
    (SELECT * FROM __answer EXCEPT ALL SELECT * FROM expected)
    UNION ALL
    (SELECT * FROM expected EXCEPT ALL SELECT * FROM __answer)
);
----
true
