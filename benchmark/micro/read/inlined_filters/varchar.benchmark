# name: benchmark/micro/read/inlined_filters/varchar.benchmark
# description: A selective VARCHAR predicate
# group: [read]

name Inlined Filter varchar
group micro
subgroup read

require ducklake

require parquet

include benchmark/micro/fixtures/inlined_filters.benchmark.in

run
SELECT id, payload FROM lake.events WHERE label = 'key73';

result_query I
WITH expected AS (SELECT id, payload FROM reference WHERE label = 'key73')
SELECT NOT EXISTS (
    (SELECT * FROM __answer EXCEPT ALL SELECT * FROM expected)
    UNION ALL
    (SELECT * FROM expected EXCEPT ALL SELECT * FROM __answer)
);
----
true
