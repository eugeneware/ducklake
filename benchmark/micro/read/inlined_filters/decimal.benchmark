# name: benchmark/micro/read/inlined_filters/decimal.benchmark
# description: A selective DECIMAL predicate
# group: [read]

name Inlined Filter decimal
group micro
subgroup read

require ducklake

require parquet

include benchmark/micro/fixtures/inlined_filters.benchmark.in

run
SELECT id, payload FROM lake.events WHERE amount = 73.25;

result_query I
WITH expected AS (SELECT id, payload FROM reference WHERE amount = 73.25)
SELECT NOT EXISTS (
    (SELECT * FROM __answer EXCEPT ALL SELECT * FROM expected)
    UNION ALL
    (SELECT * FROM expected EXCEPT ALL SELECT * FROM __answer)
);
----
true
