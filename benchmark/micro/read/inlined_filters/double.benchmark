# name: benchmark/micro/read/inlined_filters/double.benchmark
# description: A short DOUBLE range
# group: [read]

name Inlined Filter double
group micro
subgroup read

require ducklake

require parquet

include benchmark/micro/fixtures/inlined_filters.benchmark.in

run
SELECT id, payload FROM lake.events WHERE double_value >= 73.25 AND double_value < 83.25;

result_query I
WITH expected AS (SELECT id, payload FROM reference WHERE double_value >= 73.25 AND double_value < 83.25)
SELECT NOT EXISTS (
    (SELECT * FROM __answer EXCEPT ALL SELECT * FROM expected)
    UNION ALL
    (SELECT * FROM expected EXCEPT ALL SELECT * FROM __answer)
);
----
true
